# Copy to .env.local (git-ignored) and fill in. See docs/entra-setup.md.

# Application (client) ID of your Entra app registration. Not a secret.
WXT_ENTRA_CLIENT_ID=

# organizations (default), common, or a tenant ID/domain.
# Personal Microsoft accounts need their tenant, e.g. yourname.onmicrosoft.com
WXT_ENTRA_AUTHORITY=organizations
